{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(node --version)",
      "Bash(yarn --version)",
      "Bash(yarn install)",
      "Bash(yarn build)",
      "Bash(yarn lint)",
      "Bash(yarn format)",
      "Bash(yarn test)",
      "Bash(yarn test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx nest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)"
    ],
    "deny": [
      "Read(./chat-nestjs/.env.development)",
      "Read(./chat-nestjs/.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
