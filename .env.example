# Read automatically by docker compose. Copy to .env and fill in.
# Only Cloudinary needs real values, and only if you touch uploads.

# --- host ports -------------------------------------------------------------
# Defaults dodge the ports Docker Desktop commonly has taken (3000, 3306).
# WEB_PORT is used inside the container too, so HMR dials back correctly.
WEB_PORT=3100
API_PORT=8001
MYSQL_HOST_PORT=3307

# --- MySQL ------------------------------------------------------------------
# Container-only credentials. TypeORM runs with synchronize: true and will
# create every table in this database on first boot.
MYSQL_DB_NAME=zalo_web_clone
MYSQL_DB_PASSWORD=secret

# --- session ----------------------------------------------------------------
COOKIE_SECRET=change-me-to-a-long-random-string

# --- Cloudinary (avatars, banners, attachments) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- DigitalOcean Spaces (legacy S3 client) ---------------------------------
SPACES_KEY=
SPACES_SECRET_KEY=
