# Copy to .env.development (or .env.production when ENVIRONMENT=PRODUCTION) and fill in.
# Every variable below is read somewhere in src/ — keep this file in sync when you add one.

# --- runtime -----------------------------------------------------------------
# ENVIRONMENT=PRODUCTION makes app.module.ts load .env.production instead.
ENVIRONMENT=DEVELOPMENT
ENVIRONMENT_MESSAGE=local development
# The SPA (.env.development in chat-react) and the CORS allowlist assume 8001.
PORT=8001

# --- session -----------------------------------------------------------------
# express-session secret for the CHAT_APP_SESSION_ID cookie. Use a long random string.
COOKIE_SECRET=change-me

# --- MySQL -------------------------------------------------------------------
# TypeORM runs with synchronize: true — it will create/alter tables in this database.
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_USERNAME=root
MYSQL_DB_PASSWORD=
MYSQL_DB_NAME=zalo_web_clone

# --- Cloudinary (avatars, banners, attachments) ------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- DigitalOcean Spaces (legacy S3 client in image-storage.module.ts) -------
# Still instantiated at module load; leave blank if unused.
SPACES_KEY=
SPACES_SECRET_KEY=
